import { ScrollView, Palette } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { Icon, IconButton, NavItem, ActionButton, Badge } from "components/controls.slint";
import { QueueRow } from "components/media.slint";
import { PlayerBar } from "components/player-bar.slint";
import { MusicPage } from "pages/music.slint";
import { VideoPage } from "pages/video.slint";
import { RecentPage } from "pages/recent.slint";
import { SettingsPage } from "pages/settings.slint";
export { TrackRow } from "models.slint";
import { TrackRow } from "models.slint";

export component AppWindow inherits Window {
    title: "YYPlayer";
    preferred-width: 1240px;
    preferred-height: 900px;
    min-width: 1000px;
    min-height: 720px;
    background: Theme.background;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 13px;
    init => { Palette.color-scheme = ColorScheme.dark; }

    in property <int> page;
    in property <int> selected-id;
    in property <string> selected-title;
    in property <string> selected-artist;
    in property <string> selected-duration;
    in property <int> selected-cover;
    in property <float> volume;
    in property <bool> favorite;
    in property <string> status-message;
    in property <[TrackRow]> tracks;
    in property <[TrackRow]> queue;
    callback navigate(int);
    callback search-changed(string);
    callback select-preview(int);
    callback open-file();
    callback request-playback();
    callback previous();
    callback next();
    callback volume-changed(float);
    callback toggle-favorite();

    VerticalLayout {
        spacing: 0px;
        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;
            Rectangle {
                width: 180px;
                background: Theme.sidebar;
                Rectangle { x: parent.width - 1px; y: 0px; width: 1px; height: parent.height; background: #252d31; }
                VerticalLayout {
                    padding: 16px;
                    spacing: 6px;
                    HorizontalLayout {
                        height: 68px;
                        padding-left: 9px;
                        spacing: 10px;
                        Icon { icon: Icons.brand; tint: Theme.accent; width: 25px; }
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text { text: "YYPlayer"; color: Theme.text; font-size: 19px; font-weight: 700; }
                            Text { text: "音乐 · 视频"; color: Theme.faint; font-size: 10px; }
                        }
                    }
                    Rectangle { height: 16px; }
                    Text { text: "你的空间"; color: Theme.faint; font-size: 10px; height: 26px; x: 12px; }
                    NavItem { text: "音乐空间"; icon: Icons.music; selected: root.page == 0; clicked => { root.navigate(0); } }
                    NavItem { text: "视频剧场"; icon: Icons.video; selected: root.page == 1; clicked => { root.navigate(1); } }
                    NavItem { text: "最近打开"; icon: Icons.clock; selected: root.page == 2; clicked => { root.navigate(2); } }
                    Rectangle { height: 22px; }
                    Rectangle { height: 1px; background: #283034; }
                    Rectangle { height: 12px; }
                    Text { text: "本地媒体"; color: Theme.faint; font-size: 10px; height: 26px; x: 12px; }
                    NavItem { text: "打开文件"; icon: Icons.folder; clicked => { root.open-file(); } }
                    Rectangle { vertical-stretch: 1; }
                    NavItem { text: "设置"; icon: Icons.settings; selected: root.page == 3; clicked => { root.navigate(3); } }
                    Text { text: "0.0.1   /   Made with Slint"; color: Theme.faint; font-size: 9px; height: 30px; vertical-alignment: center; horizontal-alignment: center; }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0px;
                HorizontalLayout {
                    height: 88px;
                    padding-left: 28px;
                    padding-right: 28px;
                    spacing: 18px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: 5px;
                        Text { text: root.page == 0 ? "音乐空间" : (root.page == 1 ? "视频剧场" : (root.page == 2 ? "最近打开" : "设置")); color: Theme.text; font-size: 22px; font-weight: 600; }
                        Text { text: root.page == 0 ? "日常的声音，自己的节奏。" : (root.page == 1 ? "留一点时间，给喜欢的影像。" : (root.page == 2 ? "上一次的精彩，从这里继续。" : "让每一次视听，都更合心意。")); color: Theme.muted; font-size: 10px; }
                    }
                    if root.page == 0: VerticalLayout {
                        width: 150px;
                        alignment: center;
                        Rectangle {
                            height: 36px;
                            border-radius: 8px;
                            background: Theme.surface;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                Icon { icon: Icons.search; width: 15px; tint: Theme.faint; }
                                input := TextInput { color: Theme.text; font-size: 11px; single-line: true; horizontal-stretch: 1; vertical-alignment: center; accessible-label: "搜索示例曲目"; edited => { root.search-changed(self.text); } }
                            }
                            if input.text == "": Text { x: 33px; height: parent.height; text: "搜索示例曲目"; color: Theme.faint; font-size: 11px; vertical-alignment: center; }
                        }
                    }
                    if root.page != 3: VerticalLayout { width: 122px; alignment: center; ActionButton { text: "打开文件"; icon: Icons.plus; clicked => { root.open-file(); } } }
                }
                if root.page == 0: MusicPage { tracks: root.tracks; selected-id: root.selected-id; select-preview(id) => { root.select-preview(id); } }
                if root.page == 1: VideoPage { open-file => { root.open-file(); } }
                if root.page == 2: RecentPage { open-file => { root.open-file(); } }
                if root.page == 3: SettingsPage { }
                Rectangle {
                    height: 32px;
                    HorizontalLayout {
                        padding-left: 28px;
                        padding-right: 28px;
                        spacing: 7px;
                        Rectangle { width: 4px; height: 4px; y: (parent.height - self.height) / 2; border-radius: 2px; background: Theme.faint; }
                        Text { text: root.status-message; color: Theme.faint; font-size: 10px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    }
                }
            }
            Rectangle {
                width: 232px;
                background: #171d21;
                Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: #252d31; }
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 24px;
                    padding-bottom: 20px;
                    spacing: 12px;
                    HorizontalLayout {
                        height: 28px;
                        Text { text: "播放队列"; color: Theme.text; font-size: 14px; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
                        Badge { text: "" + root.queue.length; }
                    }
                    Text { text: "示例队列 · 点击预览"; color: Theme.faint; font-size: 10px; height: 24px; }
                    ScrollView {
                        vertical-stretch: 1;
                        viewport-width: self.width;
                        VerticalLayout {
                            spacing: 6px;
                            for track in root.queue: QueueRow {
                                track: track;
                                selected: root.selected-id == track.item-id;
                                clicked => { root.select-preview(track.item-id); }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    Rectangle {
                        height: 88px;
                        border-radius: 9px;
                        background: #1d2728;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            HorizontalLayout { spacing: 8px; Icon { icon: Icons.headphones; tint: Theme.accent; width: 16px; } Text { text: "听见更多细节"; color: Theme.accent; font-size: 11px; font-weight: 600; } }
                            Text { text: "输出设备与声音调整，\n在设置里轻松管理。"; color: Theme.muted; font-size: 10px; }
                        }
                    }
                }
            }
        }
        PlayerBar {
            title: root.selected-title;
            artist: root.selected-artist;
            duration: root.selected-duration;
            cover: root.selected-cover;
            volume: root.volume;
            favorite: root.favorite;
            play => { root.request-playback(); }
            previous => { root.previous(); }
            next => { root.next(); }
            volume-changed(value) => { root.volume-changed(value); }
            toggle-favorite => { root.toggle-favorite(); }
        }
    }
}
