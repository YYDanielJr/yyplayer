import { ScrollView, Palette, Button, ComboBox } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { Icon, NavItem, ActionButton } from "components/controls.slint";
import { QueueRow } from "components/media.slint";
import { PlayerBar } from "components/player-bar.slint";
import { VideoOptions } from "components/video-options.slint";
import { MusicPage } from "pages/music.slint";
import { VideoPage } from "pages/video.slint";
import { RecentPage } from "pages/recent.slint";
import { SettingsPage } from "pages/settings.slint";
export { TrackRow, ShortcutRow } from "models.slint";
import { TrackRow, ShortcutRow } from "models.slint";
export component AppWindow inherits Window {
    title: root.has-media ? root.selected-title + " · YYPlayer" : "YYPlayer";
    preferred-width: 1240px; preferred-height: 900px; min-width: 1000px; min-height: 640px;
    background: Theme.background; default-font-family: "Microsoft YaHei UI"; default-font-size: 12px;
    init => { Palette.color-scheme = ColorScheme.dark; }
    in property <int> page; in property <int> selected-id;
    in property <string> selected-title; in property <string> selected-artist; in property <string> selected-duration;
    in property <int> selected-cover; in property <float> volume; in property <bool> favorite;
    in property <string> status-message; in property <[TrackRow]> tracks; in property <[TrackRow]> queue;
    in property <int> status-revision;
    in property <[TrackRow]> recent;
    in property <bool> playing; in property <bool> has-media; in property <bool> has-video;
    in property <string> position-text; in property <float> progress; in property <bool> seekable;
    in property <bool> muted; in property <int> speed-index; in property <[string]> speed-choices;
    in property <string> media-info; in property <[string]> device-names; in property <int> device-index;
    in property <[string]> audio-tracks; in property <int> audio-index;
    in property <[string]> subtitle-tracks; in property <int> subtitle-index; in property <[string]> chapters;
    in property <bool> panel-open; in property <bool> fullscreen-mode; in property <int> window-mode;
    in property <int> decode-mode; in property <int> decode-threads; in property <bool> deinterlace;
    in property <bool> deband; in property <int> decode-scope; in property <string> decode-origin;
    in property <[ShortcutRow]> shortcut-rows; in property <int> seek-step; in property <int> volume-step;
    in property <int> hold-ms; in property <string> hold-speed; in property <int> settings-revision;
    in-out property <image> video-frame; in-out property <bool> render-ready; in-out property <string> render-error;
    in-out property <int> render-frames;
    out property <float> video-width: root.width / 1px - (root.panel-open ? 370 : 0);
    out property <float> video-height: root.height / 1px - (root.immersive ? 0 : root.controls-height / 1px);
    private property <bool> search-focused;
    out property <bool> shortcuts-blocked: root.page == 3 || root.panel-open || (root.page == 0 && root.search-focused);
    private property <bool> immersive: root.page == 1 && root.fullscreen-mode;
    private property <bool> controls-awake: true;
    in-out property <bool> pointer-in-controls;
    in-out property <bool> pointer-in-header;
    in-out property <bool> pointer-held;
    out property <bool> controls-visible: !root.immersive || root.controls-awake || root.panel-open || root.pointer-in-controls || root.pointer-held;
    out property <length> controls-height: root.page == 1 ? 70px : 104px;
    out property <length> header-height: 52px;
    out property <bool> header-visible: root.page == 1 && (root.controls-awake || root.panel-open || root.pointer-in-header || root.pointer-held);
    in-out property <bool> toast-visible;
    callback pointer-activity();
    callback dismiss-toast();
    pointer-activity => { root.controls-awake = true; hide-controls.restart(); }
    dismiss-toast => { root.toast-visible = false; }
    changed immersive => { root.pointer-activity(); }
    changed page => { root.search-focused = false; root.pointer-activity(); }
    changed status-message => { root.toast-visible = root.status-message != ""; hide-toast.restart(); }
    changed status-revision => { root.toast-visible = root.status-message != ""; hide-toast.restart(); }
    hide-controls := Timer {
        interval: 3s;
        running: root.page == 1 && root.controls-awake && !root.panel-open && !root.pointer-in-controls && !root.pointer-in-header && !root.pointer-held;
        triggered => { root.controls-awake = false; }
    }
    hide-toast := Timer {
        interval: 4s; running: root.toast-visible;
        triggered => { root.dismiss-toast(); }
    }
    callback navigate(int); callback search-changed(string); callback select-preview(int);
    callback open-file(); callback request-playback(); callback previous(); callback next();
    callback volume-changed(float); callback toggle-favorite(); callback control(string,string);
    callback shortcut-edited(int,string);
    VerticalLayout {
        x: 0px; y: 0px; width: root.width;
        height: root.height - (root.immersive ? 0px : root.controls-height);
        spacing: 0px;
        HorizontalLayout {
            vertical-stretch: 1; spacing: 0px;
            if root.page != 1 && !root.fullscreen-mode: Rectangle {
                width: 180px; background: Theme.sidebar;
                VerticalLayout {
                    padding: 16px; spacing: 6px;
                    Text { text: "YYPlayer"; color: Theme.text; font-size: 23px; font-weight: 700; height: 76px; vertical-alignment: center; }
                    NavItem { text: "音乐空间"; icon: Icons.music; selected: root.page == 0; clicked => { root.navigate(0); } }
                    NavItem { text: "视频剧场"; icon: Icons.video; selected: root.page == 1; clicked => { root.navigate(1); } }
                    NavItem { text: "最近打开"; icon: Icons.clock; selected: root.page == 2; clicked => { root.navigate(2); } }
                    NavItem { text: "打开文件"; icon: Icons.folder; clicked => { root.open-file(); } }
                    Rectangle { vertical-stretch: 1; }
                    NavItem { text: "设置"; icon: Icons.settings; selected: root.page == 3; clicked => { root.navigate(3); } }
                    Text { text: "0.1.0-dev · libmpv"; color: Theme.faint; font-size: 10px; height: 28px; horizontal-alignment: center; }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1; spacing: 0px;
                if root.page != 1: HorizontalLayout {
                    visible: !root.fullscreen-mode;
                    height: root.fullscreen-mode ? 0px : 84px; padding-left: 24px; padding-right: 24px; spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1; alignment: center; spacing: 4px;
                        Text { text: root.page == 1 ? root.selected-title : (root.page == 0 ? "音乐空间" : (root.page == 2 ? "最近打开" : "设置")); color: Theme.text; font-size: root.page == 1 ? 14px : 22px; font-weight: 600; overflow: elide; }
                    }
                    TextInput { visible: root.page == 0; width: root.page == 0 ? 140px : 0px; single-line: true; color: Theme.text; vertical-alignment: center; accessible-label: "搜索曲目"; changed has-focus => { root.search-focused = self.has-focus; } edited => { root.search-changed(self.text); } }
                    VerticalLayout { width: 110px; alignment: center; Button { text: "打开文件"; clicked => { root.open-file(); } } }
                    if root.page == 1: VerticalLayout { width: 85px; alignment: center; Button { text: "媒体库"; clicked => { root.navigate(0); } } }
                    if root.page == 1: VerticalLayout { width: 110px; alignment: center; ComboBox { model: ["窗口", "最大化", "全屏"]; current-index: root.window-mode; selected(value) => { root.control("window-mode", "" + self.current-index); } } }
                    VerticalLayout { width: 100px; alignment: center; Button { text: root.panel-open ? "关闭选项" : "播放选项"; clicked => { root.control("panel", ""); } } }
                }
                if root.page == 0: MusicPage { tracks: root.tracks; selected-id: root.selected-id; select-preview(id) => { root.select-preview(id); } select-demo-album(id) => { root.control("demo-album", "" + id); } }
                if root.page == 1: VideoPage { frame: root.video-frame; has-media: root.has-media; has-video: root.has-video; render-ready: root.render-ready; render-error: root.render-error; open-file => { root.open-file(); } control(action,value) => { root.control(action,value); } }
                if root.page == 2: Rectangle {
                    ScrollView { width: parent.width; height: parent.height; viewport-width: self.width;
                        VerticalLayout { padding: 24px; spacing: 10px;
                            if root.recent.length == 0: Text { text: "还没有打开的文件"; color: Theme.muted; height: 60px; }
                            for track in root.recent: QueueRow { track: track; clicked => { root.control("open-recent", "" + track.item-id); } }
                        }
                    }
                }
                if root.page == 3: SettingsPage {
                    bindings: root.shortcut-rows; seek-step: root.seek-step; volume-step: root.volume-step; hold-ms: root.hold-ms; hold-speed: root.hold-speed;
                    edit-binding(index,value) => { root.shortcut-edited(index,value); }
                    control(action,value) => { root.control(action,value); }
                }
            }
            if root.panel-open: VideoOptions {
                width: 370px; devices: root.device-names; device-index: root.device-index;
                audio-tracks: root.audio-tracks; audio-index: root.audio-index; subtitle-tracks: root.subtitle-tracks; subtitle-index: root.subtitle-index;
                chapters: root.chapters; info: root.media-info; decode-mode: root.decode-mode; decode-threads: root.decode-threads;
                decode-scope: root.decode-scope; decode-origin: root.decode-origin; deinterlace: root.deinterlace; deband: root.deband;
                queue: root.queue; selected-id: root.selected-id;
                control(action,value) => { root.control(action,value); }
            }
        }
    }
    if root.header-visible: Rectangle {
        x: 0px; y: 0px; width: root.video-width * 1px; height: root.header-height; background: #101719ee;
        HorizontalLayout {
            padding: 0px; padding-left: 20px; padding-right: 20px; spacing: 12px;
            Text { text: root.selected-title; color: Theme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            VerticalLayout { width: 100px; alignment: center; Button { text: "打开文件"; clicked => { root.open-file(); } } }
            VerticalLayout { width: 85px; alignment: center; Button { text: "媒体库"; clicked => { root.navigate(0); } } }
            VerticalLayout { width: 110px; alignment: center; ComboBox { model: ["窗口", "最大化", "全屏"]; current-index: root.window-mode; selected(value) => { root.control("window-mode", "" + self.current-index); } } }
            VerticalLayout { width: 100px; alignment: center; Button { text: root.panel-open ? "关闭选项" : "播放选项"; clicked => { root.control("panel", ""); } } }
        }
    }
    PlayerBar {
        y: root.height - root.controls-height; width: root.width;
        visible: root.controls-visible;
        compact: root.page == 1; playing: root.playing; has-media: root.has-media; seekable: root.seekable;
        title: root.selected-title; artist: root.selected-artist; duration: root.selected-duration; position: root.position-text;
        progress: root.progress; cover: root.selected-cover; volume: root.volume; favorite: root.favorite; muted: root.muted;
        speed-index: root.speed-index; speed-choices: root.speed-choices;
        play => { root.request-playback(); } previous => { root.previous(); } next => { root.next(); }
        volume-changed(value) => { root.volume-changed(value); } toggle-favorite => { root.toggle-favorite(); }
        control(action,value) => { root.control(action,value); }
    }
    if root.toast-visible && root.status-message != "": Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - (root.controls-visible ? root.controls-height : 0px) - self.height - 20px;
        width: min(520px, root.width - 48px); height: max(48px, toast-label.preferred-height + 24px);
        background: #232c31f2; border-color: Theme.border; border-width: 1px; border-radius: 10px;
        toast-label := Text {
            x: 16px; y: 12px; width: parent.width - 68px; height: parent.height - 24px;
            text: root.status-message; color: Theme.text; font-size: 12px; wrap: word-wrap; vertical-alignment: center;
        }
        Button {
            x: parent.width - 40px; y: (parent.height - self.height) / 2; width: 28px; height: 28px;
            text: "×"; accessible-label: "关闭提示"; clicked => { root.dismiss-toast(); }
        }
    }
}
