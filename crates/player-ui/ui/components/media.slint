import { Theme, Artwork, Icons } from "../theme.slint";
import { Icon, IconButton } from "controls.slint";
import { TrackRow } from "../models.slint";

export component Cover inherits Image {
    in property <int> artwork-id;
    source: root.artwork-id == 1 ? Artwork.water : (root.artwork-id == 2 ? Artwork.sun : Artwork.night);
    image-fit: contain;
}

export component AlbumCard inherits Rectangle {
    in property <int> artwork-id;
    in property <string> title;
    in property <string> subtitle;
    callback clicked();
    height: root.width + 62px;
    background: transparent;
    accessible-role: button;
    accessible-label: root.title;
    VerticalLayout {
        spacing: 8px;
        Cover { artwork-id: root.artwork-id; height: self.width; horizontal-stretch: 1; }
        Text { text: root.title; color: Theme.text; font-size: 13px; font-weight: 600; height: 18px; overflow: elide; }
        Text { text: root.subtitle; color: Theme.muted; font-size: 11px; height: 18px; overflow: elide; }
        Rectangle { height: 2px; }
    }
    if touch.has-hover: Rectangle {
        width: 32px;
        height: 32px;
        x: parent.width - 42px;
        y: parent.width - 42px;
        border-radius: 16px;
        background: Theme.accent;
        Icon { icon: Icons.arrow; tint: Theme.accent-ink; x: 7px; y: 7px; width: 18px; height: 18px; }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

export component SongRow inherits Rectangle {
    in property <TrackRow> track;
    in property <int> number;
    in property <bool> selected;
    callback clicked();
    height: 52px;
    border-radius: 7px;
    background: root.selected ? #1d302b : (touch.has-hover ? Theme.surface : transparent);
    accessible-role: button;
    accessible-label: root.track.title + "，" + root.track.artist;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 14px;
        Text { width: 20px; text: root.number < 10 ? "0" + root.number : "" + root.number; color: root.selected ? Theme.accent : Theme.faint; font-size: 11px; vertical-alignment: center; }
        VerticalLayout { width: 36px; alignment: center; Cover { artwork-id: root.track.cover; width: 36px; height: 36px; } }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            Text { text: root.track.title; color: root.selected ? Theme.accent : Theme.text; font-size: 12px; overflow: elide; }
            Text { text: root.track.artist; color: Theme.muted; font-size: 10px; overflow: elide; }
        }
        Text { text: root.track.collection; width: 75px; color: Theme.muted; font-size: 11px; vertical-alignment: center; overflow: elide; }
        Text { text: root.track.duration; width: 36px; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

export component QueueRow inherits Rectangle {
    in property <TrackRow> track;
    in property <bool> selected;
    callback clicked();
    height: 68px;
    border-radius: 8px;
    background: root.selected ? #23362f : (touch.has-hover ? Theme.raised : transparent);
    accessible-role: button;
    accessible-label: root.track.title;
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        Cover { artwork-id: root.track.cover; width: 42px; height: 42px; }
        VerticalLayout {
            alignment: center;
            spacing: 5px;
            horizontal-stretch: 1;
            Text { text: root.track.title; color: root.selected ? Theme.accent : Theme.text; font-size: 11px; overflow: elide; }
            Text { text: root.track.artist; color: Theme.muted; font-size: 9px; overflow: elide; }
        }
        Text { text: root.track.duration; color: Theme.faint; font-size: 9px; vertical-alignment: center; }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}
