import { ListView, CheckBox, LineEdit } from "std-widgets.slint";
import { ThemeButton as Button, ThemeComboBox as ComboBox } from "../components/theme-widgets.slint";
import { Theme, Icons } from "../theme.slint";
import { Icon, IconButton, ActionButton } from "../components/controls.slint";
import { GlassSurface } from "../components/glass.slint";
import { SongRow } from "../components/media.slint";
import { TrackRow } from "../models.slint";
export component MusicPage inherits Rectangle {
    min-width: 0px; min-height: 0px; horizontal-stretch: 1; vertical-stretch: 1;
    in-out property <int> visible-first; in-out property <int> visible-count;
    in property <[TrackRow]> tracks; in property <[TrackRow]> library-tracks;
    in-out property <float> column-song: 0.46; in-out property <float> column-artist: 0.24;
    in property <int> selected-id; in property <int> library-selected;
    in property <bool> preview; in property <[string]> folders; in property <int> folder-index;
    in property <bool> scanning;
    in property <int> category; in property <[TrackRow]> groups; in property <bool> group-open;
    in property <string> collection-title; in property <[string]> playlists; in property <int> playlist-index;
    in property <[bool]> checked; in property <int> checked-count;
    private property <bool> group-view: (root.category == 1 || root.category == 2) && !root.group-open;
    private property <bool> queue-view: root.preview;
    private property <bool> show-tools: true;
    in-out property <int> dialog; private property <string> name-draft; private property <int> target-playlist;
    private property <bool> folder-choice-focused; private property <bool> playlist-choice-focused;
    out property <bool> input-focused: root.dialog > 0 || (root.category == 3 ? root.playlist-choice-focused : root.folder-choice-focused);
    changed category => { root.folder-choice-focused = false; root.playlist-choice-focused = false; }
    callback focus-changed(bool);
    changed input-focused => { root.focus-changed(root.input-focused); }
    private property <float> entered: 0;
    init => { root.entered = 1; }
    opacity: root.entered; animate entered { duration: Theme.smooth; easing: ease-out; }
    callback select-preview(int); callback select-demo-album(int); callback control(string,string);
    VerticalLayout { padding-left: 24px; padding-right: 24px; padding-bottom: 20px; spacing: 12px;
        toolbar := Rectangle {
            min-width: 0px; horizontal-stretch: 1;
            private property <int> rows: self.width >= 900px ? 1 : (self.width >= 560px ? 2 : 3);
            height: 38px + (self.rows - 1) * 46px;
            if root.show-tools: HorizontalLayout { x: 0px; y: 0px; width: 254px; height: 38px; spacing: 10px;
                ActionButton { width: 122px; text: "添加目录"; icon: Icons.folder; clicked => { root.control("library-folder-add", ""); } }
                ActionButton { width: 122px; text: "添加歌曲"; icon: Icons.plus; primary: false; clicked => { root.control("library-files-add", ""); } }
            }
            categories := HorizontalLayout { x: toolbar.rows == 1 ? 262px : 0px; y: toolbar.rows == 1 ? 0px : 46px; width: 226px; height: 38px; spacing: 6px;
                for label[index] in ["歌曲", "歌手", "专辑", "歌单"]: Button { width: 52px; text: label; primary: root.category == index; clicked => { root.control("library-category", "" + index); } }
            }
            filters := Rectangle {
                x: toolbar.rows == 1 ? 496px : (toolbar.rows == 2 ? 234px : 0px);
                y: toolbar.rows == 1 ? 0px : (toolbar.rows == 2 ? 46px : 92px);
                width: toolbar.width - self.x - (toolbar.rows == 1 ? 92px : 0px); height: 38px;
                if !root.queue-view && root.show-tools && root.category != 3: HorizontalLayout { spacing: 6px;
                    ComboBox { focus-changed(focused) => { root.folder-choice-focused = focused; } model: root.folders; current-index: root.folder-index; horizontal-stretch: 1; min-width: 0px; selected(value, choice) => { root.control("library-folder", "" + choice); } }
                    Button { width: 52px; text: root.scanning ? "取消" : "重扫"; clicked => { root.control(root.scanning ? "library-cancel" : "library-rescan", ""); } }
                    Button { width: 52px; text: "移除"; enabled: root.folder-index > 0 && root.folder-index < root.folders.length - 1; clicked => { root.control("library-folder-remove", ""); } }
                    Text { width: 68px; text: "" + root.library-tracks.length + " 首"; color: Theme.faint; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                }
                if root.category == 3: HorizontalLayout { spacing: 6px;
                    ComboBox { focus-changed(focused) => { root.playlist-choice-focused = focused; } horizontal-stretch: 1; min-width: 0px; model: root.playlists; current-index: root.playlist-index; selected(value, choice) => { root.control("playlist-select", "" + choice); } }
                    Button { text: "重命名"; enabled: root.playlist-index > 0; clicked => { root.name-draft=root.collection-title; root.dialog=2; } }
                    Button { text: "删除歌单"; enabled: root.playlist-index > 0; clicked => { root.dialog=4; } }
                }
            }
            if root.show-tools: Button { x: toolbar.width - self.width; y: 0px; width: 84px; height: 38px; text: "新建歌单"; clicked => { root.name-draft=""; root.dialog=1; } }
        }
        if root.group-open: HorizontalLayout { height: 32px; spacing: 10px;
            Button { text: root.category == 1 ? "全部歌手" : "全部专辑"; clicked => { root.control("library-group-back", ""); } }
            Text { text: root.collection-title; color: Theme.text; font-size: 18px; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        }
        if !root.queue-view && root.library-tracks.length > 0 && !root.group-view: HorizontalLayout { height: 34px; spacing: 6px;
            Button { text: root.checked-count == root.library-tracks.length ? "取消全选" : "全选"; clicked => { root.control("library-check-all", ""); } }
            Button { text: root.checked-count > 0 ? "播放所选" : "播放全部"; primary: true; clicked => { root.control("library-batch-play", ""); } }
            Button { text: "加入队列"; clicked => { root.control("library-enqueue", ""); } }
            Button { text: "加入歌单"; clicked => { root.target-playlist=0; root.dialog=3; } }
            if root.category == 3: Button { text: "移出歌单"; enabled: root.checked-count > 0; clicked => { root.control("playlist-remove", ""); } }
            Text { text: root.checked-count > 0 ? "已选 " + root.checked-count + " 首" : ""; color: Theme.accent-text; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        }
        if !root.queue-view && root.library-tracks.length == 0 && !root.group-view: GlassSurface { vertical-stretch: 1;
            VerticalLayout { padding: 16px; spacing: 14px; alignment: center;
                HorizontalLayout { alignment: center; height: 40px; Icon { icon: Icons.music; tint: Theme.accent; width: 40px; height: 40px; } }
                Text { text: root.category == 3 ? "歌单还是空的" : (root.scanning ? "正在寻找你的音乐" : (root.folders.length > 2 ? "没有找到歌曲" : "还没有歌曲")); color: Theme.text; font-size: 24px; font-weight: 600; horizontal-alignment: center; height: 36px; }
                Text { text: root.category == 3 ? "在歌曲、歌手或专辑中选中喜欢的歌曲，\n点击「加入歌单」，让音乐常伴左右。" : "添加音乐目录，开启你的音乐空间。\n子目录中的歌曲会一起加入，也可以单独添加歌曲。"; color: Theme.muted; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; height: 52px; }
                HorizontalLayout { alignment: center; spacing: 12px; height: 38px;
                    ActionButton { width: 138px; text: "添加音乐目录"; icon: Icons.folder; clicked => { root.control("library-folder-add", ""); } }
                    ActionButton { width: 122px; text: "添加歌曲"; icon: Icons.plus; primary: false; clicked => { root.control("library-files-add", ""); } }
                }
            }
        }
        if root.group-view: group-list := ListView { vertical-stretch: 1; viewport-width: self.width;
            for group[index] in root.groups: Rectangle { height: 76px;
                Rectangle { width: parent.width - 24px; height: 68px; border-radius: 12px; background: touch.has-hover ? Theme.selected : Theme.surface.with-alpha(0.65);
                    Icon { x: 18px; y: 22px; width: 24px; height: 24px; icon: root.category == 1 ? Icons.music : Icons.grid; tint: Theme.accent-text; }
                    Text { x: 58px; y: 12px; width: parent.width - 120px; height: 25px; text: group.title; color: Theme.text; font-size: 17px; font-weight: 600; overflow: elide; }
                    Text { x: 58px; y: 39px; width: parent.width - 100px; height: 20px; text: root.category == 1 ? group.collection : group.artist + " · " + group.collection; color: Theme.muted; font-size: 12px; overflow: elide; }
                    Icon { x: parent.width - 36px; y: 25px; width: 18px; height: 18px; icon: Icons.arrow; }
                    focus := FocusScope { key-pressed(event) => { if event.text == " " || event.text == "\n" { root.control("library-group", "" + group.item-id); return accept; } return reject; } }
                    touch := TouchArea { mouse-cursor: pointer; clicked => {focus.focus(); root.control("library-group", "" + group.item-id); } }
                }
            }
        }
        if !root.group-view && (root.queue-view || root.library-tracks.length > 0): column-header := Rectangle {
            height: 30px;
            private property <length> row-width: self.width - 24px - (root.queue-view ? 0px : 70px);
            private property <length> prefix: (self.row-width < 520px ? 38px : 88px) + (root.queue-view ? 0px : 32px);
            private property <length> columns: max(1px,self.row-width - self.prefix + (root.queue-view ? 0px : 32px) - 58px);
            Text { x: parent.prefix; width: parent.columns * root.column-song - 12px; height: parent.height; text: "歌曲"; color: Theme.faint; vertical-alignment: center; }
            Text { x: parent.prefix + parent.columns * root.column-song + 6px; width: parent.columns * root.column-artist - 12px; height: parent.height; text: "歌手"; color: Theme.faint; vertical-alignment: center; }
            Text { x: parent.prefix + parent.columns * (root.column-song + root.column-artist) + 6px; width: parent.columns * (1 - root.column-song - root.column-artist) - 12px; height: parent.height; text: "专辑"; color: Theme.faint; vertical-alignment: center; }
            Text { x: parent.row-width - 52px + (root.queue-view ? 0px : 32px); width: 40px; height: parent.height; text: "时长"; color: Theme.faint; vertical-alignment: center; horizontal-alignment: center; }
            for divider[index] in [0,1]: TouchArea {
                x: parent.prefix + parent.columns * (index == 0 ? root.column-song : root.column-song + root.column-artist) - 4px;
                width: 8px; height: parent.height; mouse-cursor: ew-resize;
                private property <length> origin; private property <float> start;
                Rectangle { x: 3px; y: 7px; width: 1px; height: parent.height - 14px; background: Theme.border; }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { self.origin = self.x + self.mouse-x; self.start = index == 0 ? root.column-song : root.column-artist; }
                    if event.kind == PointerEventKind.up && event.button == PointerEventButton.left { root.control("library-columns", root.column-song + "," + root.column-artist); }
                }
                moved => { if self.pressed {
                    if index == 0 { root.column-song = clamp(self.start + (self.x + self.mouse-x - self.origin) / parent.columns, 0.2, min(0.7, 0.85 - root.column-artist)); }
                    else { root.column-artist = clamp(self.start + (self.x + self.mouse-x - self.origin) / parent.columns, 0.1, min(0.5, 0.85 - root.column-song)); }
                } }
                double-clicked => { root.column-song = 0.46; root.column-artist = 0.24; root.control("library-columns", "0.46,0.24"); }
            }
        }
        if !root.group-view && (root.queue-view || root.library-tracks.length > 0): song-list := ListView {
            vertical-stretch: 1; viewport-width: self.width;
            in property <bool> showing-library: !root.queue-view;
            callback report-visible();
            report-visible => {root.visible-first=max(0,floor(-self.viewport-y / 58px)); root.visible-count=self.showing-library ? ceil(self.height / 58px)+2 : 0;}
            init => {self.report-visible();}
            changed viewport-y => {self.report-visible();}
            changed height => {self.report-visible();}
            changed showing-library => {self.report-visible();}
            for track[index] in (root.queue-view ? root.tracks : root.library-tracks): Rectangle { height: 58px;
                if !root.queue-view: CheckBox { x: 0px; y: (parent.height - self.height) / 2; width: 28px; checked: root.checked[index]; toggled => { root.control("library-check", "" + track.item-id); } }
                SongRow { x: root.queue-view ? 0px : 32px; y: 2px; width: parent.width - 24px - (root.queue-view ? 0px : 70px); column-song: root.column-song; column-artist: root.column-artist; height: parent.height - 4px; track: track; number: index + 1; selected: track.item-id == (root.queue-view ? root.selected-id : root.library-selected);
                    clicked => { if root.queue-view { root.select-preview(track.item-id); } else { root.control("library-play", "" + track.item-id); } }
                }
                if !root.queue-view: IconButton { x: parent.width - 24px - 32px; y: (parent.height - self.height) / 2; width: 28px; height: 28px; icon: Icons.minus; label: "从音乐库移除，不删除文件"; clicked => { root.control("library-song-remove", "" + track.item-id); } }
            }
        }
    }
    if root.dialog > 0: Rectangle { width: parent.width; height: parent.height; background: #00000066;
        TouchArea { clicked => { root.dialog=0; } }
        Rectangle { width: min(460px,parent.width - 40px); height: 240px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; background: Theme.surface; border-radius: 18px; border-width: 1px; border-color: Theme.border;
            TouchArea { }
            VerticalLayout { padding: 24px; spacing: 16px;
                Text { text: root.dialog == 1 ? "新建歌单" : (root.dialog == 2 ? "重命名歌单" : (root.dialog == 3 ? "加入歌单" : "删除歌单")); color: Theme.text; font-size: 20px; font-weight: 600; height: 28px; }
                if root.dialog == 1 || root.dialog == 2: LineEdit { text <=> root.name-draft; placeholder-text: "输入歌单名称"; }
                if root.dialog == 3: ComboBox { model: root.playlists; current-index: root.target-playlist; selected(value, choice) => { root.target-playlist = choice; } }
                Text { text: root.dialog == 4 ? "删除「" + root.collection-title + "」？歌曲文件和当前播放列表会保留。" : (root.dialog == 3 ? (root.checked-count > 0 ? "将所选 " + root.checked-count + " 首歌曲添加到歌单" : "将当前列表全部歌曲添加到歌单") : "给喜欢的音乐留一个位置。最多 80 个字符。" ); color: Theme.muted; font-size: 12px; wrap: word-wrap; vertical-stretch: 1; }
                HorizontalLayout { height: 36px; spacing: 12px; alignment: end;
                    Button { text: "取消"; clicked => { root.dialog=0; } }
                    Button { text: root.dialog == 4 ? "删除" : "确定"; primary: true; clicked => { root.control(root.dialog == 1 ? "playlist-create" : (root.dialog == 2 ? "playlist-rename" : (root.dialog == 3 ? "playlist-add" : "playlist-delete")), root.dialog == 3 ? "" + root.target-playlist : root.name-draft); root.dialog=0; } }
                }
            }
        }
    }
}
