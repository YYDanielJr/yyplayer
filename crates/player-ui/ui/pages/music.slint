import { ListView, ComboBox, Button } from "std-widgets.slint";
import { Theme, Icons } from "../theme.slint";
import { Icon, IconButton, ActionButton } from "../components/controls.slint";
import { GlassSurface } from "../components/glass.slint";
import { SongRow } from "../components/media.slint";
import { TrackRow } from "../models.slint";
export component MusicPage inherits Rectangle {
    in-out property <int> visible-first; in-out property <int> visible-count;
    in property <[TrackRow]> tracks; in property <[TrackRow]> library-tracks;
    in-out property <float> column-song: 0.46; in-out property <float> column-artist: 0.24;
    in property <int> selected-id; in property <int> library-selected;
    in property <bool> preview; in property <bool> compact; in property <[string]> folders; in property <int> folder-index;
    in property <bool> scanning; in property <string> library-message;
    private property <bool> queue-view: root.preview || (root.library-tracks.length == 0 && root.tracks.length > 0);
    private property <bool> show-tools: root.queue-view || root.library-tracks.length > 0 || root.scanning || root.folders.length > 2;
    private property <float> entered: 0;
    init => { root.entered = 1; }
    opacity: root.entered; animate entered { duration: Theme.smooth; easing: ease-out; }
    callback select-preview(int); callback select-demo-album(int); callback control(string,string);
    VerticalLayout { padding-left: 24px; padding-right: 24px; padding-bottom: 20px; spacing: 12px;
        if !root.compact && (root.queue-view || root.library-tracks.length > 0): GlassSurface { height: 126px; clip: true;
            Rectangle { x: parent.width - 200px; y: -50px; width: 250px; height: 250px; border-radius: 125px; background: Theme.glow; }
            Rectangle { x: parent.width - 162px; y: -16px; width: 182px; height: 182px; border-radius: 91px; border-width: 1px; border-color: Theme.accent.with-alpha(0.18); background: transparent; }
            VerticalLayout { padding: 22px; spacing: 6px; alignment: center;
                Text { text: "YOUR MUSIC, YOUR SPACE"; color: Theme.accent-text; font-size: 9px; height: 14px; }
                Text { text: "把喜欢的声音，收进这里。"; color: Theme.text; font-size: 22px; overflow: elide; font-weight: 600; height: 36px; }
                Text { text: "本地音乐 · 原声输出 · 为你留白"; color: Theme.muted; font-size: 11px; height: 20px; }
            }
        }
        if root.show-tools: HorizontalLayout { height: 38px; spacing: 10px;
            ActionButton { max-width: 128px; text: "添加目录"; icon: Icons.folder; clicked => { root.control("library-folder-add", ""); } }
            ActionButton { max-width: 128px; text: "添加歌曲"; icon: Icons.plus; primary: false; clicked => { root.control("library-files-add", ""); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: root.queue-view ? "音乐库" : "当前队列"; clicked => { root.queue-view = !root.queue-view; } }
        }
        if !root.queue-view && root.show-tools: HorizontalLayout { height: 36px; spacing: 8px;
            ComboBox { model: root.folders; current-index: root.folder-index; horizontal-stretch: 1; selected(value) => { root.control("library-folder", "" + self.current-index); } }
            Button { text: root.scanning ? "取消" : "重扫"; clicked => { root.control(root.scanning ? "library-cancel" : "library-rescan", ""); } }
            Button { text: "移除"; enabled: root.folder-index > 0 && root.folder-index < root.folders.length - 1; clicked => { root.control("library-folder-remove", ""); } }
        }
        if root.show-tools: HorizontalLayout { height: 24px;
            Text { text: root.queue-view ? "播放队列" : "音乐库"; color: Theme.text; font-size: 14px; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
            Text { text: "" + (root.queue-view ? root.tracks.length : root.library-tracks.length) + " 首"; color: Theme.faint; vertical-alignment: center; }
        }
        if !root.queue-view && root.show-tools: Text { text: root.scanning ? "正在后台扫描… 可以继续播放和浏览" : root.library-message; color: Theme.muted; height: 22px; overflow: elide; }
        if !root.queue-view && root.library-tracks.length == 0: GlassSurface { vertical-stretch: 1;
            VerticalLayout { padding: 30px; spacing: 14px; alignment: center;
                HorizontalLayout { alignment: center; height: 40px; Icon { icon: Icons.music; tint: Theme.accent; width: 40px; height: 40px; } }
                Text { text: root.scanning ? "正在寻找你的音乐" : (root.folders.length > 2 ? "没有找到歌曲" : "还没有歌曲"); color: Theme.text; font-size: 24px; font-weight: 600; horizontal-alignment: center; height: 36px; }
                Text { text: "添加音乐目录，开启你的音乐空间。\n子目录中的歌曲会一起加入，也可以单独添加歌曲。"; color: Theme.muted; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; height: 52px; }
                HorizontalLayout { alignment: center; spacing: 12px; height: 38px;
                    ActionButton { width: 138px; text: "添加音乐目录"; icon: Icons.folder; clicked => { root.control("library-folder-add", ""); } }
                    ActionButton { width: 122px; text: "添加歌曲"; icon: Icons.plus; primary: false; clicked => { root.control("library-files-add", ""); } }
                }
            }
        }
        if root.queue-view || root.library-tracks.length > 0: Rectangle {
            height: 30px;
            private property <length> row-width: self.width - 24px - (root.queue-view ? 0px : 38px);
            private property <length> prefix: self.row-width < 520px ? 38px : 88px;
            private property <length> columns: max(1px,self.row-width - self.prefix - 58px);
            Text { x: parent.prefix; width: parent.columns * root.column-song - 12px; height: parent.height; text: "歌曲"; color: Theme.faint; vertical-alignment: center; }
            Text { x: parent.prefix + parent.columns * root.column-song + 6px; width: parent.columns * root.column-artist - 12px; height: parent.height; text: "歌手"; color: Theme.faint; vertical-alignment: center; }
            Text { x: parent.prefix + parent.columns * (root.column-song + root.column-artist) + 6px; width: parent.columns * (1 - root.column-song - root.column-artist) - 12px; height: parent.height; text: "专辑"; color: Theme.faint; vertical-alignment: center; }
            Text { x: parent.row-width - 52px; width: 40px; height: parent.height; text: "时长"; color: Theme.faint; vertical-alignment: center; horizontal-alignment: center; }
            for divider[index] in [0,1]: TouchArea {
                x: parent.prefix + parent.columns * (index == 0 ? root.column-song : root.column-song + root.column-artist) - 4px;
                width: 8px; height: parent.height; mouse-cursor: ew-resize;
                private property <length> origin; private property <float> start;
                Rectangle { x: 3px; y: 7px; width: 1px; height: parent.height - 14px; background: Theme.border; }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { self.origin = self.x + self.mouse-x; self.start = index == 0 ? root.column-song : root.column-artist; }
                    if event.kind == PointerEventKind.up && event.button == PointerEventButton.left { root.control("library-columns", root.column-song + "," + root.column-artist); }
                }
                moved => { if self.pressed {
                    if index == 0 { root.column-song = clamp(self.start + (self.x + self.mouse-x - self.origin) / parent.columns, 0.2, min(0.7, 0.85 - root.column-artist)); }
                    else { root.column-artist = clamp(self.start + (self.x + self.mouse-x - self.origin) / parent.columns, 0.1, min(0.5, 0.85 - root.column-song)); }
                } }
                double-clicked => { root.column-song = 0.46; root.column-artist = 0.24; root.control("library-columns", "0.46,0.24"); }
            }
        }
        if root.queue-view || root.library-tracks.length > 0: ListView {
            vertical-stretch: 1; viewport-width: self.width;
            in property <bool> showing-library: !root.queue-view;
            callback report-visible();
            report-visible => {root.visible-first=max(0,floor(-self.viewport-y / 58px)); root.visible-count=self.showing-library ? ceil(self.height / 58px)+2 : 0;}
            init => {self.report-visible();}
            changed viewport-y => {self.report-visible();}
            changed height => {self.report-visible();}
            changed showing-library => {self.report-visible();}
            for track[index] in (root.queue-view ? root.tracks : root.library-tracks): Rectangle { height: 58px;
                SongRow { x: 0px; y: 2px; width: parent.width - 24px - (root.queue-view ? 0px : 38px); column-song: root.column-song; column-artist: root.column-artist; height: parent.height - 4px; track: track; number: index + 1; selected: track.item-id == (root.queue-view ? root.selected-id : root.library-selected);
                    clicked => { if root.queue-view { root.select-preview(track.item-id); } else { root.control("library-play", "" + track.item-id); } }
                }
                if !root.queue-view: IconButton { x: parent.width - 24px - 32px; y: (parent.height - self.height) / 2; width: 28px; height: 28px; icon: Icons.minus; label: "从音乐库移除，不删除文件"; clicked => { root.control("library-song-remove", "" + track.item-id); } }
            }
        }
    }
}
