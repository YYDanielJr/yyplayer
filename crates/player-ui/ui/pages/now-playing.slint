import { Button, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { MusicArt } from "../components/music-art.slint";
import { LyricRow } from "../models.slint";
export component NowPlaying inherits Rectangle {
    in property <image> artwork; in property <string> title; in property <string> artist; in property <string> album;
    in property <bool> playing; in property <[LyricRow]> lyrics; in property <int> active; in property <string> plain;
    in property <string> output-status; in property <string> lyric-font;
    private property <bool> follow: true;
    private property <float> breathe: 0;
    private property <length> entrance: 14px;
    init => { root.entrance = 0px; }
    animate entrance { duration: Theme.smooth; easing: ease-out; }
    callback control(string,string);
    background: @linear-gradient(120deg, Theme.background, Theme.sidebar, Theme.background);
    Timer { interval: 3s; running: root.playing && !Theme.reduced-motion; triggered => { root.breathe = root.breathe == 0 ? 1 : 0; } }
    Rectangle { x: parent.width * 0.1; y: parent.height * 0.16; width: parent.width * 0.65; height: self.width; border-radius: self.width / 2; background: Theme.accent; opacity: 0.025 + root.breathe * 0.025; animate opacity { duration: Theme.reduced-motion ? 0ms : 3s; easing: ease-in-out; } }
    HorizontalLayout { x: 26px; y: 20px; width: parent.width - 52px; height: 34px;
        Button { text: "收起"; clicked => { root.control("music-browse", ""); } }
        Rectangle { horizontal-stretch: 1; }
        Button { text: "音频信息与输出 / EQ"; clicked => { root.control("panel", ""); } }
    }
    HorizontalLayout { x: 54px; y: 76px + root.entrance; width: parent.width - 108px; height: parent.height - 110px; spacing: 56px;
        VerticalLayout { horizontal-stretch: 1; spacing: 16px; alignment: center;
            Rectangle { height: min(350px, self.width); horizontal-stretch: 1;
                MusicArt { x: (parent.width - self.width) / 2; width: min(350px, parent.width); height: self.width; artwork: root.artwork; playing: root.playing; animated: true; }
            }
            Text { text: root.title; color: Theme.text; font-size: 25px; font-weight: 600; horizontal-alignment: center; overflow: elide; height: 40px; }
            Text { text: root.artist == "" ? "本地音乐" : root.artist; color: Theme.muted; font-size: 14px; height: 24px; horizontal-alignment: center; overflow: elide; }
            if root.album != "": Text { text: root.album; color: Theme.faint; font-size: 12px; height: 20px; horizontal-alignment: center; overflow: elide; }
            Text { text: root.output-status; color: Theme.faint; font-size: 11px; height: 24px; horizontal-alignment: center; overflow: elide; }
            if root.lyrics.length == 0 && root.plain == "": Button { text: "导入本地歌词"; clicked => { root.control("lyrics-import", ""); } }
        }
        if root.lyrics.length > 0 || root.plain != "": VerticalLayout {
            horizontal-stretch: 1; spacing: 12px;
            HorizontalLayout { height: 28px; Text { text: "LYRICS"; color: Theme.faint; font-size: 10px; horizontal-stretch: 1; vertical-alignment: center; } Button { text: root.follow ? "自动跟随" : "自由浏览"; clicked => { root.follow = !root.follow; } } }
            lyrics-view := ScrollView { vertical-stretch: 1; viewport-width: self.width;
                in property <int> line: root.active;
                in property <bool> following: root.follow;
                callback follow-line();
                follow-line => { if self.following && root.lyrics.length > 0 { self.viewport-y = -min(max(0px, self.line * 56px), max(0px, self.viewport-height - self.height)); } }
                changed line => { self.follow-line(); }
                changed following => { self.follow-line(); }
                changed height => { self.follow-line(); }
                changed viewport-height => { self.follow-line(); }
                animate viewport-y { duration: Theme.smooth; easing: ease-in-out; }
                VerticalLayout { spacing: 0px; padding-top: root.lyrics.length > 0 ? max(0px, lyrics-view.height / 2 - 28px) : 0px; padding-bottom: self.padding-top;
                    if root.lyrics.length == 0: Text { text: root.plain; font-family: root.lyric-font; color: Theme.text; font-size: 18px; wrap: word-wrap; }
                    for line[index] in root.lyrics: Rectangle {
                        height: 56px;
                        Text { text: line.text; font-family: root.lyric-font; width: parent.width; height: parent.height; color: index == root.active ? Theme.accent-text : (touch.has-hover ? Theme.text : Theme.muted); font-size: index == root.active ? 21px : 17px; font-weight: index == root.active ? 600 : 400; vertical-alignment: center; wrap: word-wrap;
                            animate color, font-size { duration: Theme.smooth; easing: ease-in-out; }
                        }
                        touch := TouchArea { mouse-cursor: pointer; clicked => { root.control("lyrics-seek", "" + line.milliseconds); } }
                    }
                }
            }
            Button { text: "更换歌词"; clicked => { root.control("lyrics-import", ""); } }
        }
    }
}
