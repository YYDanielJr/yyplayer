import { ListView, ComboBox, Button } from "std-widgets.slint";
import { Theme, Icons } from "../theme.slint";
import { Icon, IconButton, ActionButton } from "../components/controls.slint";
import { GlassSurface } from "../components/glass.slint";
import { TrackRow } from "../models.slint";
export component VideoLibraryPage inherits Rectangle {
    in property <[TrackRow]> tracks; in property <[string]> folders;
    in property <int> folder-index; in property <int> selected-id;
    in property <bool> scanning; in property <bool> can-resume;
    callback control(string,string);
    VerticalLayout {
        padding-left: 24px; padding-right: 24px; padding-bottom: 20px; spacing: 12px;
        HorizontalLayout { height: 38px; spacing: 10px;
            ActionButton { max-width: 128px; text: "添加目录"; icon: Icons.folder; clicked => { root.control("video-folder-add", ""); } }
            ActionButton { max-width: 128px; text: "添加视频"; icon: Icons.plus; primary: false; clicked => { root.control("video-files-add", ""); } }
            Rectangle { horizontal-stretch: 1; }
            if root.can-resume: Button { text: "继续观看"; clicked => { root.control("video", ""); } }
        }
        HorizontalLayout { height: 36px; spacing: 8px;
            ComboBox { model: root.folders; current-index: root.folder-index; horizontal-stretch: 1; selected(value) => { root.control("video-folder", "" + self.current-index); } }
            Button { text: root.scanning ? "取消" : "重扫"; clicked => { root.control(root.scanning ? "video-cancel" : "video-rescan", ""); } }
            Button { text: "移除目录"; enabled: root.folder-index > 0 && root.folder-index < root.folders.length - 1; clicked => { root.control("video-folder-remove", ""); } }
            Text { text: "" + root.tracks.length + " 个"; color: Theme.faint; vertical-alignment: center; }
        }
        if root.tracks.length == 0: GlassSurface {
            vertical-stretch: 1;
            VerticalLayout { padding: 30px; spacing: 14px; alignment: center;
                HorizontalLayout { alignment: center; height: 40px; Icon { icon: Icons.video; tint: Theme.accent; width: 40px; height: 40px; } }
                Text { text: root.scanning ? "正在寻找你的视频" : "把喜欢的画面，收进这里。"; color: Theme.text; font-size: 24px; font-weight: 600; horizontal-alignment: center; height: 36px; }
                Text { text: "添加目录或单个视频，点击列表开始观看。\n子目录会一起扫描，移除记录不会删除文件。"; color: Theme.muted; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; height: 52px; }
            }
        }
        if root.tracks.length > 0: Rectangle {
            height: 30px;
            Text { x: 60px; width: max(1px,parent.width * 0.48 - 72px); height: parent.height; text: "视频"; color: Theme.faint; vertical-alignment: center; }
            Text { x: parent.width * 0.48; width: max(1px,parent.width * 0.52 - 160px); height: parent.height; text: parent.width < 600px ? "目录" : "所在目录"; color: Theme.faint; vertical-alignment: center; }
            Text { x: parent.width - 156px; width: 88px; height: parent.height; text: "文件大小"; color: Theme.faint; horizontal-alignment: right; vertical-alignment: center; }
        }
        if root.tracks.length > 0: ListView {
            vertical-stretch: 1; viewport-width: self.width;
            for track[index] in root.tracks: Rectangle {
                height: 64px;
                Rectangle { x: 0px; y: 2px; height: 60px; width: parent.width - 24px; border-radius: Theme.radius;
                    background: track.item-id == root.selected-id ? Theme.selected : (touch.has-hover ? Theme.surface : transparent);
                    touch := TouchArea { width: parent.width - 40px; height: parent.height; mouse-cursor: pointer; clicked => { root.control("video-play", "" + track.item-id); } }
                    Icon { x: 18px; y: 20px; width: 20px; height: 20px; icon: Icons.video; tint: track.item-id == root.selected-id ? Theme.accent-text : Theme.muted; }
                    Text { x: 60px; width: max(1px,(parent.width + 24px) * 0.48 - 72px); height: parent.height; text: track.title; color: Theme.text; vertical-alignment: center; overflow: elide; }
                    Text { x: (parent.width + 24px) * 0.48; width: max(1px,(parent.width + 24px) * 0.52 - 160px); height: parent.height; text: track.artist; color: Theme.muted; vertical-alignment: center; overflow: elide; }
                    Text { x: parent.width - 132px; width: 88px; height: parent.height; text: track.collection; color: Theme.faint; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                    IconButton { x: parent.width - 36px; y: 16px; width: 28px; height: 28px; icon: Icons.minus; label: "从视频库移除，不删除文件"; clicked => { root.control("video-remove", "" + track.item-id); } }
                }
            }
        }
    }
}
