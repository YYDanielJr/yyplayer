import { Theme, Icons, Artwork } from "../theme.slint";
import { Icon, ActionButton, Badge } from "../components/controls.slint";

export component VideoPage inherits Rectangle {
    callback open-file();
    VerticalLayout {
        padding-left: 28px;
        padding-right: 28px;
        padding-bottom: 28px;
        spacing: 22px;
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            min-height: 270px;
            border-radius: 12px;
            clip: true;
            Image { width: parent.width; height: parent.height; source: Artwork.cinema; image-fit: cover; }
            VerticalLayout {
                alignment: center;
                spacing: 16px;
                Rectangle {
                    width: 60px;
                    height: 60px;
                    border-radius: 30px;
                    background: #b2e5cd24;
                    border-width: 1px;
                    border-color: #b2e5cd66;
                    Icon { icon: Icons.play; tint: Theme.accent; width: 24px; height: 24px; x: 20px; y: 18px; }
                }
                Text { text: "你的下一场放映"; color: Theme.text; font-size: 24px; font-weight: 600; horizontal-alignment: center; height: 36px; }
                Text { text: "让画面填满视线，让声音陪你入场。"; color: #b7c9c3; font-size: 12px; horizontal-alignment: center; height: 20px; }
                HorizontalLayout { alignment: center; ActionButton { text: "打开视频"; icon: Icons.plus; clicked => { root.open-file(); } } }
            }
            HorizontalLayout { y: parent.height - 32px; height: 22px; padding-left: 14px; padding-right: 14px; Text { text: "示例画面"; color: #8ba19c; font-size: 10px; } Rectangle { horizontal-stretch: 1; } Text { text: "当前未加载媒体"; color: #8ba19c; font-size: 10px; } }
        }
        Rectangle {
            height: 96px;
            border-radius: 10px;
            background: Theme.surface;
            HorizontalLayout {
                padding: 20px;
                spacing: 16px;
                Icon { icon: Icons.video; tint: Theme.accent; width: 28px; }
                VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    Text { text: "音乐之外，还有影像。"; color: Theme.text; font-size: 14px; font-weight: 600; }
                    Text { text: "字幕、音轨与画面选项，将在这里集中呈现。"; color: Theme.muted; font-size: 11px; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
}
