import { Theme, Icons } from "../theme.slint";
import { ActionButton } from "../components/controls.slint";
export component VideoPage inherits Rectangle {
    in property <image> frame; in property <bool> has-media; in property <bool> has-video;
    in property <bool> render-ready; in property <string> render-error;
    callback open-file(); callback control(string,string);
    background: #080b0d;
    Image { visible: root.has-media && root.has-video; x: 0px; y: 0px; width: parent.width; height: parent.height; source: root.frame; image-fit: contain; }
    touch := TouchArea {
        clicked => { root.control("focus-video", ""); }
        double-clicked => { root.control("fullscreen", ""); }
        scroll-event(event) => { root.control("wheel-volume", "" + (event.delta-y / 1px)); return accept; }
    }
    if !root.has-media: VerticalLayout {
        alignment: center; spacing: 16px;
        Text { text: "你的下一场放映"; color: Theme.text; font-size: 26px; font-weight: 600; horizontal-alignment: center; height: 40px; }
        Text { text: "打开文件，或把视频拖入窗口。"; color: Theme.muted; font-size: 13px; horizontal-alignment: center; height: 24px; }
        HorizontalLayout { alignment: center; ActionButton { text: "打开视频"; icon: Icons.plus; clicked => { root.open-file(); } } }
        Text { text: "空格暂停 · 方向键进度 / 音量 · 长按方向键临时加速"; color: Theme.faint; font-size: 11px; horizontal-alignment: center; height: 30px; }
    }
    if root.has-media && !root.has-video: Text { text: "正在播放音频"; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; font-size: 22px; }
    if root.render-error != "": Rectangle {
        y: 12px; x: 20px; width: parent.width - 40px; height: 54px; border-radius: 6px; background: #482a2a;
        Text { x: 12px; width: parent.width - 24px; height: parent.height; text: root.render-error; color: #f2c7bb; wrap: word-wrap; vertical-alignment: center; font-size: 12px; }
    }
}
